---
/**
 * ProjectCard — kartu proyek berbasis hierarki rekayasa perangkat lunak:
 * Project Info → Problem / Purpose → What I Built → Engineering Highlights → Tech Stack → Links.
 */
import PaperCard from './ui/PaperCard.astro';
import DeviceFrame from './ui/DeviceFrame.astro';
import Tag from './ui/Tag.astro';
import { isFilled, isPlaceholder } from '@/lib/placeholder';
import type { Project } from '@/data/types';
import type { Tilt } from '@/lib/ui';

interface Props {
  project: Project;
  /** Urutan (mulai 0) — untuk nomor "PROJECT 01" dan variasi rotasi. */
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const tilts: Tilt[] = ['none', 'slight-right', 'none'];
const headingId = `project-${number}-title`;
const alt = isFilled(project.name) ? `Screenshot of ${project.name}` : 'Project screenshot';
const isDesktop = project.category === 'web' || project.stack.some((s) => s.toLowerCase().includes('web')) || project.context.toLowerCase().includes('web');
---

<PaperCard
  as="article"
  tilt={tilts[index % tilts.length]}
  padding="none"
  interactive
  class:list={[
    'frame flex h-full flex-col overflow-hidden',
    { 'border-blue-ink/30 ring-1 ring-blue-ink/10': project.featured }
  ]}
  ariaLabelledby={headingId}
>
  <!-- Screenshot di atas "meja kerja" -->
  <div class:list={[
    'desk flex items-center justify-center border-b border-line px-4 py-5 sm:px-6',
    isDesktop ? 'h-48 sm:h-52' : 'h-60 sm:h-64'
  ]}>
    <DeviceFrame
      src={project.image}
      alt={alt}
      type={isDesktop ? 'desktop' : 'mobile'}
      class={isDesktop ? 'w-full max-w-[280px] sm:max-w-[320px]' : 'w-28 sm:w-32'}
    />
  </div>

  <div class="flex flex-1 flex-col gap-3.5 p-5 sm:p-6">
    <!-- Header: Project Number, Context, & Primary Badge -->
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <p class="font-mono text-xs font-bold tracking-widest text-blue-ink">PROJECT {number}</p>
        {project.featured && (
          <span class="rounded bg-blue-tint px-1.5 py-0.5 font-mono text-[10px] font-bold text-blue-ink uppercase">
            Primary
          </span>
        )}
      </div>
      <Tag>{project.context}</Tag>
    </div>

    <!-- Title & Purpose -->
    <div>
      <h3 id={headingId} class="text-xl font-bold tracking-tight text-ink sm:text-2xl">{project.name}</h3>
      {project.purpose && (
        <p class="mt-1 text-xs font-medium text-ink-soft leading-relaxed">
          {project.purpose}
        </p>
      )}
    </div>

    <!-- Description / What I Built -->
    <p class="text-sm text-ink-soft leading-relaxed">{project.description}</p>

    <!-- Engineering Highlights -->
    {project.highlights && project.highlights.length > 0 && (
      <div class="rounded border border-line/80 bg-paper/60 p-3 sm:p-3.5">
        <p class="font-mono text-[11px] font-semibold tracking-wider text-ink-soft uppercase">
          Engineering Highlights
        </p>
        <ul class="mt-2 space-y-1 text-xs text-ink">
          {project.highlights.map((highlight) => (
            <li class="flex items-start gap-1.5">
              <span class="text-blue-ink font-bold shrink-0 leading-none">✓</span>
              <span class="leading-snug">{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Tech Stack -->
    <div class="pt-1">
      <p class="sr-only">Tech stack</p>
      <ul class="flex flex-wrap gap-1.5">
        {project.stack.map((tech) => (
          <li><Tag>{tech}</Tag></li>
        ))}
      </ul>
    </div>

    <!-- Action Links -->
    <ul class="mt-auto flex flex-wrap gap-x-5 gap-y-2 border-t border-dashed border-line pt-4 text-sm font-semibold">
      {project.links.map((link) =>
        isPlaceholder(link.href) ? (
          <li>
            <span class="inline-flex min-h-11 items-center gap-1 text-ink-soft" title={link.href}>
              {link.label} <span class="font-mono text-xs font-normal">(no link yet)</span>
            </span>
          </li>
        ) : (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-1 underline decoration-orange decoration-2 underline-offset-4 hover:decoration-ink"
            >
              {link.label} <span aria-hidden="true">→</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ),
      )}
    </ul>
  </div>
</PaperCard>
