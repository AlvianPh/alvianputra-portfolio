<script>
  function setupResearchFigTabs() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.research-fig-btn');
    const panels = document.querySelectorAll<HTMLElement>('.research-fig-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-fig-target');
        if (!targetId) return;

        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-green-ink', 'text-paper-light', 'border-green-ink');
          b.classList.add('bg-paper', 'text-ink-soft', 'border-line');
        });

        btn.classList.add('active', 'bg-green-ink', 'text-paper-light', 'border-green-ink');
        btn.classList.remove('bg-paper', 'text-ink-soft', 'border-line');

        panels.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
            p.classList.add('block');
          } else {
            p.classList.add('hidden');
            p.classList.remove('block');
          }
        });
      });
    });
  }

  setupResearchFigTabs();
  document.addEventListener('astro:page-load', setupResearchFigTabs);
</script>
