---
/**
 * Education — "academic record".
 * Tahun yang masih placeholder tetap tampil sebagai pengingat untuk diisi.
 */
import Section from '@/components/Section.astro';
import PaperCard from '@/components/ui/PaperCard.astro';
import Stamp from '@/components/ui/Stamp.astro';
import { portfolio } from '@/data/portfolio';

const { education } = portfolio;
const rows = [
  { label: 'Degree', value: education.degree },
  { label: 'GPA', value: education.gpa },
  { label: 'Period', value: `${education.startYear} — ${education.endYear}` },
];
---

<Section id="education" title="Education" index="06" label="academic record" labelColor="blue" class="border-t border-line">
  <PaperCard
    tilt="slight-left"
    tape="top-right"
    tapeColor="blue"
    padding="lg"
    class="max-w-3xl"
    ariaLabelledby="education-record-title"
  >
    <div class="flex flex-wrap items-start justify-between gap-4 border-b-2 border-double border-line pb-4">
      <div>
        <p id="education-record-title" class="font-mono text-xs font-semibold tracking-widest text-ink-soft uppercase">
          Academic record
        </p>
        <p class="mt-1 text-xl font-bold tracking-tight sm:text-2xl">{education.institution}</p>
      </div>
      <Stamp color="green">GPA {education.gpa}</Stamp>
    </div>

    <dl class="mt-2 divide-y divide-dashed divide-line">
      {rows.map((row) => (
        <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
          <dt class="font-mono text-xs tracking-widest text-ink-soft uppercase sm:pt-1">{row.label}</dt>
          <dd class="min-w-0 font-medium break-words">{row.value}</dd>
        </div>
      ))}
    </dl>
  </PaperCard>
</Section>
