---
/**
 * Professional Experience — Section 04
 * Career Logbook · Experience, Mentorship & Leadership:
 * - Menyatukan riwayat rekayasa software independen, mentorship mengajar coding & AI di SMK Koperasi, serta keaktifan organisasi akademik.
 * - Format: Linimasa berkas agenda kerja di sisi kiri, dan lembar catatan dividen rekayasa (Field Logbook) di sisi kanan.
 */
import Section from '@/components/Section.astro';
import PaperCard from '@/components/ui/PaperCard.astro';
import Stamp from '@/components/ui/Stamp.astro';
import HandNote from '@/components/ui/HandNote.astro';
import { portfolio } from '@/data/portfolio';

const { teaching, contact } = portfolio;
const milestones = teaching.milestones || [];
---

<div id="teaching" class="sr-only" aria-hidden="true"></div>

<Section
  id="experience"
  title="Career Logbook"
  index="04"
  label="experience & leadership"
  labelColor="orange"
  class="border-t border-line"
>
  <!-- Section Subtitle & Narrative -->
  <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="max-w-2xl space-y-1.5">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs font-bold tracking-widest text-orange-ink uppercase">
          Engineering Delivery · Mentorship · Academic Footprints
        </span>
        <span class="text-ink-soft">·</span>
        <HandNote color="orange" size="sm">practical track record</HandNote>
      </div>
      <p class="text-base sm:text-lg text-ink-soft leading-relaxed">
        A progressive record of production software engineering, dedicated vocational coding instruction, and academic community leadership.
      </p>
    </div>

    <Stamp color="orange">Verified Log</Stamp>
  </div>

  <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-12">
    
    <!-- ============================================================
         KOLOM KIRI: LINIMASA BERKAS KARIR (3 Milestone Utama)
         ============================================================ -->
    <div class="space-y-6 lg:col-span-7">
      <div class="relative pl-6 sm:pl-8 border-l-2 border-dashed border-orange-ink/40 space-y-8">
        
        {milestones.map((item) => {
          const isEngineering = item.type === 'engineering';
          const isTeaching = item.type === 'teaching';

          return (
            <div class="relative group">
              <!-- Timeline Marker Pin -->
              <span
                class={`absolute -left-[31px] sm:-left-[39px] top-1.5 flex h-4 w-4 sm:h-5 sm:w-5 items-center justify-center rounded-full border-2 border-paper text-[9px] font-mono font-bold shadow-2xs ${
                  isEngineering
                    ? 'bg-blue-ink text-paper-light'
                    : isTeaching
                    ? 'bg-orange-ink text-paper-light'
                    : 'bg-green-ink text-paper-light'
                }`}
                aria-hidden="true"
              >
                {isEngineering ? '⚡' : isTeaching ? '👨‍🏫' : '✦'}
              </span>

              <!-- Milestone Card Container -->
              <div class="rounded-xl border border-line bg-paper-light p-5 sm:p-6 shadow-xs hover:shadow-paper transition-shadow">
                
                <!-- Period & Type Badge Header -->
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-2.5 mb-3">
                  <span class="font-mono text-xs font-bold text-ink-soft">
                    • {item.period}
                  </span>
                  <span
                    class={`rounded px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider ${
                      isEngineering
                        ? 'bg-blue-tint text-blue-ink border border-blue-ink/20'
                        : isTeaching
                        ? 'bg-orange-tint text-orange-ink border border-orange-ink/20'
                        : 'bg-green-tint text-green-ink border border-green-ink/20'
                    }`}
                  >
                    {item.type}
                  </span>
                </div>

                <!-- Role & Organization -->
                <div>
                  <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink group-hover:text-orange-ink transition-colors">
                    {item.role}
                  </h3>
                  <p class="font-mono text-xs font-semibold text-orange-ink mt-0.5">
                    {item.organization}
                  </p>
                </div>

                <!-- Description Narrative -->
                {item.description && (
                  <p class="mt-2.5 text-xs sm:text-sm text-ink-soft leading-relaxed">
                    {item.description}
                  </p>
                )}

                {item.curriculumObjectives && (
                  <div class="mt-3.5 rounded-lg border border-orange-ink/30 bg-orange-tint/40 p-3 sm:p-3.5 text-xs">
                    <div class="flex items-center justify-between font-mono text-[11px] font-bold text-orange-ink mb-2">
                      <span class="flex items-center gap-1.5">
                        <span>📚</span>
                        <span>CURRICULUM SPECIFICATION (CP KKA)</span>
                      </span>
                      <span class="rounded bg-orange-ink/15 px-1.5 py-0.2 text-[9px] uppercase font-bold">
                        6 Objectives
                      </span>
                    </div>

                    <p class="font-sans text-[11px] font-semibold text-ink mb-2">
                      {item.curriculumObjectives.tracks}
                    </p>

                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pt-2 border-t border-dashed border-orange-ink/20 font-mono text-[11px] text-ink/90">
                      {item.curriculumObjectives.objectives.map((obj) => (
                        <li class="flex items-start gap-1.5">
                          <span class="text-orange-ink font-bold shrink-0 mt-0.5">•</span>
                          <span>{obj}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <!-- Tags Strip -->
                <div class="mt-4 flex flex-wrap gap-1.5 pt-2 border-t border-dashed border-line">
                  {item.tags.map((tag) => (
                    <span class="rounded bg-paper px-2 py-0.5 font-mono text-[11px] font-semibold text-ink border border-line shadow-2xs">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          );
        })}

      </div>
    </div>

    <!-- ============================================================
         KOLOM KANAN: LEMBAR CATATAN DIVIDEN REKAYASA (Field Logbook)
         ============================================================ -->
    <div class="lg:col-span-5 relative">
      <!-- Tape di pojok kanan atas -->
      <span class="tape tape-top-right" style="--tape-color: var(--color-orange);" aria-hidden="true"></span>

      <PaperCard
        surface="lined"
        tilt="slight-right"
        padding="none"
        class="paper-margin py-7 pr-6 sm:pr-8 shadow-paper-lift relative overflow-hidden"
        ariaLabelledby="experience-log-title"
      >
        <!-- Header Logbook -->
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-line pb-3 mb-4">
          <div>
            <p id="experience-log-title" class="font-mono text-[11px] font-bold tracking-widest text-orange-ink uppercase">
              Field Logbook #04
            </p>
            <p class="mt-0.5 text-xl font-extrabold tracking-tight text-ink">Engineering Dividends</p>
            <p class="font-mono text-xs text-ink-soft">Mentorship & Delivery Synergies</p>
          </div>
          <Stamp color="orange">Active Log</Stamp>
        </div>

        <!-- 3 Core Quantitative Highlights -->
        <dl class="grid grid-cols-3 gap-2 border-y border-dashed border-line py-4 my-2">
          <div class="flex min-w-0 flex-col-reverse text-center sm:text-left">
            <dt class="mt-1 font-mono text-[10px] font-bold text-ink-soft uppercase leading-tight">Systems Built</dt>
            <dd class="text-2xl sm:text-3xl font-black tracking-tight text-ink font-mono">6+</dd>
          </div>
          <div class="flex min-w-0 flex-col-reverse text-center sm:text-left">
            <dt class="mt-1 font-mono text-[10px] font-bold text-ink-soft uppercase leading-tight">Students Taught</dt>
            <dd class="text-2xl sm:text-3xl font-black tracking-tight text-ink font-mono">140+</dd>
          </div>
          <div class="flex min-w-0 flex-col-reverse text-center sm:text-left">
            <dt class="mt-1 font-mono text-[10px] font-bold text-ink-soft uppercase leading-tight">Curriculum Modules</dt>
            <dd class="text-2xl sm:text-3xl font-black tracking-tight text-ink font-mono">6 CP</dd>
          </div>
        </dl>

        <!-- Soft-Skill Dividends Checklist -->
        <div class="mt-5 space-y-3">
          <p class="font-mono text-xs font-bold tracking-widest text-ink uppercase">Why this benefits software teams:</p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-ink">
            <li class="flex items-start gap-2">
              <span class="text-orange-ink font-bold shrink-0">✓</span>
              <span><strong>Architectural Clarity:</strong> Experienced in deconstructing intricate system logic into intuitive mental models for cross-functional teammates.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-orange-ink font-bold shrink-0">✓</span>
              <span><strong>Empathetic Code Reviews:</strong> Mentoring vocational student cohorts developed habits for constructive, solution-driven, and clear code reviews.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-orange-ink font-bold shrink-0">✓</span>
              <span><strong>Root-Cause Debugging:</strong> Seasoned at breaking down compilation and runtime bugs systematically rather than relying on guesswork.</span>
            </li>
          </ul>
        </div>

        <!-- Teacher's Quote Note -->
        <div class="mt-5 rounded-lg border border-orange-ink/30 bg-orange-tint/40 p-3.5 shadow-2xs">
          <p class="font-hand text-sm sm:text-base text-ink leading-snug">
            "Teaching code proved that true technical mastery is demonstrated by the ability to explain complex abstractions simply."
          </p>
        </div>

        <!-- External Link Ticket to Full CV / LinkedIn -->
        <div class="mt-5 pt-3 border-t border-dashed border-line flex items-center justify-between">
          <span class="font-mono text-[11px] text-ink-soft">Full Career History:</span>
          <a
            href={contact.links.find((l) => l.label === 'LinkedIn')?.href || '#contact'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-mono text-xs font-bold text-orange-ink underline decoration-orange-ink decoration-2 underline-offset-4 hover:text-ink transition-colors"
          >
            <span>LinkedIn Profile</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </PaperCard>
    </div>

  </div>
</Section>
