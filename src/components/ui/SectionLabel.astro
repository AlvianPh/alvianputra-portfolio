---
/** Label kecil di atas judul section, mis. "02 — research notes". */
import { accentText, type Accent } from '@/lib/ui';

interface Props {
  index?: string;
  color?: Accent;
  class?: string;
}

const { index, color = 'green', class: className } = Astro.props;
---

<p class:list={['flex items-center gap-2 font-hand text-xl leading-none', accentText[color], className]}>
  {index && <span class="font-mono text-xs tracking-widest text-ink-soft">{index}</span>}
  <span aria-hidden="true" class="h-px w-6 bg-current opacity-60"></span>
  <span><slot /></span>
</p>
