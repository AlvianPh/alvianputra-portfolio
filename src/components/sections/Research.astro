---
/**
 * Applied AI & NLP Research — Section 05
 * Scientific Lab Dossier & Empirical Machine Learning Rigor
 * 
 * Re-architected 3-Tier Progressive Storytelling Hierarchy:
 * - TIER 1: Executive Summary & 4 High-Impact Metric Chips (Full Width)
 * - TIER 2: Two Peer-Reviewed Publications (Side-by-Side 50:50 Grid for IEEE & FAHMA)
 * - TIER 3: Empirical Lab Desk (5:7 Split between 3-Oracle Pipeline Architecture & Interactive Figure Viewer)
 */
import Section from '@/components/Section.astro';
import PaperCard from '@/components/ui/PaperCard.astro';
import Stamp from '@/components/ui/Stamp.astro';
import Tag from '@/components/ui/Tag.astro';
import HandNote from '@/components/ui/HandNote.astro';
import { portfolio } from '@/data/portfolio';

const { research } = portfolio;
const ieeePub = research.publications.find((p) => p.venue.includes('IEEE')) || research.publications[0];
const fahmaPub = research.publications.find((p) => p.venue.includes('FAHMA')) || research.publications[1];
---

<div id="research" class="sr-only" aria-hidden="true"></div>

<Section
  id="research"
  title="Applied AI & NLP Research"
  index="05"
  label="empirical lab dossier"
  labelColor="green"
  class="border-t border-line"
>
  <!-- Section Subtitle & Narrative -->
  <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="max-w-2xl space-y-1.5">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs font-bold tracking-widest text-green-ink uppercase">
          Empirical Machine Learning & Natural Language Processing
        </span>
        <span class="text-ink-soft">·</span>
        <HandNote color="green" size="sm">scientific rigor</HandNote>
      </div>
      <p class="text-base sm:text-lg text-ink-soft leading-relaxed">
        A specialized research focus on transformer language representations and annotation-efficient active learning, validated through peer-reviewed academic publications and reproducible empirical benchmarks.
      </p>
    </div>

    <Stamp color="green">Peer-Reviewed</Stamp>
  </div>

  <div class="space-y-10">
    <!-- ============================================================
         TIER 1: EXECUTIVE SUMMARY & IMPACT METRICS BAR (Full-Width)
         ============================================================ -->
    <PaperCard surface="grid" tilt="none" padding="lg" class="relative shadow-paper border-green-ink/30 overflow-hidden">
      <!-- Washi tape at top-left -->
      <span class="tape tape-top-left" style="--tape-color: #10b981;" aria-hidden="true"></span>

      <!-- Scientist Cat Mascot perched on top-right -->
      <div class="cat-sticker absolute -top-4 sm:-top-6 right-4 sm:right-10 z-20 group cursor-pointer" title="Scientist Cat: Hypothesis tested & verified!">
        <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none absolute -top-7 right-0 whitespace-nowrap rounded-md border border-line bg-paper-light px-2 py-0.5 font-hand text-xs font-bold text-ink shadow-xs">
          <span>Hypothesis tested & verified! 🐾</span>
        </div>
        <!-- Cat with scientist round glasses -->
        <svg class="h-10 w-10 sm:h-12 sm:w-12 select-none drop-shadow-sm transition-transform duration-200 group-hover:scale-110" viewBox="0 0 60 50" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 40 C10 24, 20 12, 23 20 C26 18, 34 18, 37 20 C40 12, 50 24, 48 40 Z" fill="#ffffff" stroke="#231f20" stroke-width="2" stroke-linejoin="round"/>
          <path d="M14 40 C12 26, 20 15, 23 22 C26 20, 34 20, 37 22 C40 15, 48 26, 46 40 Z" fill="#FFFDF8"/>
          <polygon points="17,21 21,17 22,23" fill="#FCA5A5" />
          <polygon points="43,21 39,17 38,23" fill="#FCA5A5" />
          <!-- Scientist Glasses -->
          <circle cx="23" cy="30" r="5" stroke="#231f20" stroke-width="1.8" fill="rgba(255,255,255,0.7)"/>
          <circle cx="37" cy="30" r="5" stroke="#231f20" stroke-width="1.8" fill="rgba(255,255,255,0.7)"/>
          <line x1="28" y1="30" x2="32" y2="30" stroke="#231f20" stroke-width="1.8"/>
          <!-- Eyes behind glasses -->
          <circle cx="23" cy="30" r="1.5" fill="#231f20" />
          <circle cx="37" cy="30" r="1.5" fill="#231f20" />
          <!-- Nose & mouth -->
          <polygon points="29,36 31,36 30,37" fill="#F87171" />
          <path d="M28 38 Q30 40 30 38 Q30 40 32 38" stroke="#231f20" stroke-width="1.4" stroke-linecap="round" fill="none"/>
        </svg>
      </div>

      <!-- Lab Header Strip -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded bg-green-tint font-mono text-xs text-green-ink">🔬</span>
          <p class="font-mono text-xs font-bold tracking-widest text-green-ink uppercase">
            Lab Dossier #05 · IndoBERT & Multi-Oracle Specialization
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="rounded bg-green-tint px-2.5 py-0.5 font-mono text-[10px] font-bold text-green-ink uppercase border border-green-ink/30">
            Transformer & NLP
          </span>
          <span class="rounded bg-paper px-2 py-0.5 font-mono text-[10px] font-bold text-ink-soft border border-line">
            • Concluded Dec 2025
          </span>
          <span class="hidden sm:inline font-mono text-xs text-ink-soft">STMIK El Rahma</span>
        </div>
      </div>

      <!-- Main Headline Topic -->
      <h3 class="text-xl sm:text-2xl md:text-3xl font-black tracking-tight text-ink leading-snug max-w-4xl">
        {research.topic}
      </h3>

      <p class="mt-3 text-sm sm:text-base leading-relaxed text-ink-soft font-sans max-w-3xl">
        {research.summary}
      </p>

      <!-- Keywords Strip -->
      <div class="mt-4 flex flex-wrap gap-1.5">
        {research.keywords.map((kw) => (
          <Tag>{kw}</Tag>
        ))}
      </div>

      <!-- 4 Key Impact Stat Badges (Prominent Numbers, Symmetrical & Level) -->
      <div class="mt-6 pt-5 border-t border-dashed border-line grid grid-cols-2 md:grid-cols-4 gap-3">
        <!-- Stat 1 -->
        <div class="rounded-lg border border-green-ink/30 bg-green-tint/50 p-3.5 shadow-2xs flex flex-col justify-between h-full">
          <div>
            <p class="font-mono text-2xl sm:text-3xl font-black text-green-ink leading-none">90.1%</p>
            <p class="mt-1 font-mono text-[11px] font-bold uppercase text-ink">Label Cost Saved</p>
          </div>
          <p class="mt-2 text-[10px] text-ink-soft leading-tight">149 queries to hit 90% benchmark performance</p>
        </div>

        <!-- Stat 2 -->
        <div class="rounded-lg border border-blue-ink/30 bg-blue-tint/50 p-3.5 shadow-2xs flex flex-col justify-between h-full">
          <div>
            <p class="font-mono text-2xl sm:text-3xl font-black text-blue-ink leading-none">~8%</p>
            <p class="mt-1 font-mono text-[11px] font-bold uppercase text-ink">Human Burden</p>
          </div>
          <p class="mt-2 text-[10px] text-ink-soft leading-tight">Human attention spent only on ambiguous samples</p>
        </div>

        <!-- Stat 3 -->
        <div class="rounded-lg border border-orange-ink/30 bg-orange-tint/50 p-3.5 shadow-2xs flex flex-col justify-between h-full">
          <div>
            <p class="font-mono text-2xl sm:text-3xl font-black text-orange-ink leading-none">0.6277</p>
            <p class="mt-1 font-mono text-[11px] font-bold uppercase text-ink">Macro-F1 Score</p>
          </div>
          <p class="mt-2 text-[10px] text-ink-soft leading-tight">Evaluated across 8,966 YouTube MBG comments</p>
        </div>

        <!-- Stat 4 -->
        <div class="rounded-lg border border-purple-300 bg-purple-50/70 p-3.5 shadow-2xs flex flex-col justify-between h-full">
          <div>
            <p class="font-mono text-2xl sm:text-3xl font-black text-purple-900 leading-none">2 Papers</p>
            <p class="mt-1 font-mono text-[11px] font-bold uppercase text-ink">Peer-Reviewed</p>
          </div>
          <p class="mt-2 text-[10px] text-ink-soft leading-tight">IEEE ICERA 2026 & Jurnal FAHMA (Sinta 4)</p>
        </div>
      </div>
    </PaperCard>

    <!-- ============================================================
         TIER 2: THE TWO PEER-REVIEWED PUBLICATIONS (50:50 Side-by-Side)
         Level, symmetrical, equal height
         ============================================================ -->
    <div>
      <div class="mb-4 flex items-center justify-between border-b border-line pb-2.5">
        <div class="flex items-center gap-2">
          <p class="font-mono text-xs font-bold tracking-widest text-ink uppercase">
            Peer-Reviewed Academic Credentials
          </p>
          <span class="text-ink-soft">·</span>
          <HandNote color="green" size="sm">primary author & IEEE accepted</HandNote>
        </div>
        <span class="font-mono text-xs text-green-ink font-bold">2 Indexed Venues</span>
      </div>

      <div class="grid gap-6 md:grid-cols-2 items-stretch">
        <!-- Paper 1: IEEE Conference (ICERA 2026) -->
        <article class="paper-cutout paper-lined p-6 sm:p-7 relative border-green-ink/40 flex flex-col justify-between h-full shadow-paper">
          <span class="tape tape-top-left" style="--tape-color: #10b981;" aria-hidden="true"></span>
          
          <div class="flex flex-col flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-2.5 mb-3">
              <div class="flex items-center gap-1.5">
                <span class="rounded bg-blue-ink px-2 py-0.5 font-mono text-[10px] font-bold text-paper-light uppercase">
                  IEEE Xplore
                </span>
                <span class="font-mono text-xs font-bold text-blue-ink">ICERA 2026</span>
              </div>
              <Stamp color="green">Published</Stamp>
            </div>

            <h4 class="text-base sm:text-lg font-bold text-ink leading-snug min-h-[3.25rem] flex items-center">
              {ieeePub.title}
            </h4>

            <p class="mt-1 font-mono text-xs text-green-ink font-semibold">
              ★ {ieeePub.note}
            </p>

            <!-- Formal Citation & DOI Box -->
            <div class="mt-4 rounded border border-line bg-paper/70 p-3 text-[11px] font-mono text-ink-soft leading-relaxed space-y-1">
              <p class="text-ink font-bold">{ieeePub.authors || 'Minarwati and A. P. Hardiadi'} ({ieeePub.year}).</p>
              <p class="italic text-ink/80 leading-normal">"{ieeePub.title}"</p>
              <p class="text-ink-soft">{ieeePub.venue}.</p>
              {ieeePub.doi && (
                <p class="text-green-ink font-bold pt-1 select-all">DOI: {ieeePub.doi}</p>
              )}
            </div>

            <p class="mt-3 text-xs text-ink-soft leading-relaxed font-sans">
              <strong class="text-ink">Core Contribution:</strong> Designed an adaptive 3-oracle active learning pipeline with entropy-based query routing, cutting human annotation costs by 90.1% using 768-d embeddings from Hugging Face model <code class="text-blue-ink">Aardiiiiy/indobertweet-base</code>.
            </p>
          </div>

          <!-- Actions -->
          <div class="mt-5 pt-3 border-t border-dashed border-line flex flex-wrap items-center justify-between gap-2">
            <a
              href={ieeePub.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded border border-ink bg-ink px-3 py-1.5 font-mono text-xs font-bold text-paper-light hover:bg-green-ink hover:border-green-ink transition-colors no-underline"
            >
              <span>View Paper on IEEE DOI</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a
              href="https://github.com/AlvianPh/multi-oracle-al-indobert-mbg"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-ink-soft hover:text-ink transition-colors"
            >
              <span>Source Notebooks</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <!-- Paper 2: SINTA 4 Journal (Jurnal FAHMA 2026) -->
        <article class="paper-cutout paper-lined p-6 sm:p-7 relative border-orange-ink/40 flex flex-col justify-between h-full shadow-paper">
          <span class="tape tape-top-right" style="--tape-color: #f59e0b;" aria-hidden="true"></span>
          
          <div class="flex flex-col flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-2.5 mb-3">
              <div class="flex items-center gap-1.5">
                <span class="rounded bg-orange-ink px-2 py-0.5 font-mono text-[10px] font-bold text-paper-light uppercase">
                  Sinta 4
                </span>
                <span class="font-mono text-xs font-bold text-orange-ink">Jurnal FAHMA (Vol. 24 No. 2)</span>
              </div>
              <Stamp color="orange">Published</Stamp>
            </div>

            <h4 class="text-base sm:text-lg font-bold text-ink leading-snug min-h-[3.25rem] flex items-center">
              {fahmaPub.title}
            </h4>

            <p class="mt-1 font-mono text-xs text-orange-ink font-semibold">
              ★ {fahmaPub.note}
            </p>

            <!-- Formal Citation & DOI Box -->
            <div class="mt-4 rounded border border-line bg-paper/70 p-3 text-[11px] font-mono text-ink-soft leading-relaxed space-y-1">
              <p class="text-ink font-bold">{fahmaPub.authors || 'Alvian Putra Hardiadi and Minarwati'} ({fahmaPub.year}).</p>
              <p class="italic text-ink/80 leading-normal">"{fahmaPub.title}"</p>
              <p class="text-ink-soft">{fahmaPub.venue}.</p>
              {fahmaPub.doi && (
                <p class="text-orange-ink font-bold pt-1 select-all">DOI: {fahmaPub.doi}</p>
              )}
            </div>

            <p class="mt-3 text-xs text-ink-soft leading-relaxed font-sans">
              <strong class="text-ink">Core Contribution:</strong> Proved that the Human-in-the-Loop *skip* mechanism acts as an implicit quality filter preventing noisy annotations from entering the training set, achieving a +0.0235 Macro-F1 gain with only 50 annotated samples.
            </p>
          </div>

          <!-- Actions -->
          <div class="mt-5 pt-3 border-t border-dashed border-line flex flex-wrap items-center justify-between gap-2">
            <a
              href={fahmaPub.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded border border-ink bg-ink px-3 py-1.5 font-mono text-xs font-bold text-paper-light hover:bg-orange-ink hover:border-orange-ink transition-colors no-underline"
            >
              <span>View Paper on OJS FAHMA</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a
              href="https://github.com/AlvianPh/al-margin-sampling-sentiment-mbg"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-ink-soft hover:text-ink transition-colors"
            >
              <span>Dataset & Scripts</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </div>
    </div>

    <!-- ============================================================
         TIER 3: TECHNICAL DEEP DIVE (Balanced 50:50 Symmetrical Grid)
         Left (50%): Multi-Oracle Architecture & Experimental Flow
         Right (50%): Interactive Experimental Notebook Figure Viewer
         ============================================================ -->
    <div>
      <div class="mb-4 flex items-center justify-between border-b border-line pb-2.5">
        <div class="flex items-center gap-2">
          <p class="font-mono text-xs font-bold tracking-widest text-ink uppercase">
            Technical Methodology & Empirical Evidence
          </p>
          <span class="text-ink-soft">·</span>
          <HandNote color="blue" size="sm">architecture & verified plots</HandNote>
        </div>
        <span class="font-mono text-xs text-blue-ink font-bold">PyTorch / Colab Runs</span>
      </div>

      <div class="grid gap-6 md:grid-cols-2 items-stretch">
        <!-- SISI KIRI (50%): Arsitektur Pipeline Multi-Oracle -->
        <div class="rounded-xl border border-line bg-paper-light p-6 shadow-paper relative flex flex-col justify-between h-full">
          <span class="tape tape-top-center" style="--tape-color: #3b82f6;" aria-hidden="true"></span>
          
          <div class="flex flex-col flex-1">
            <div class="flex items-center justify-between border-b border-dashed border-line pb-2.5 mb-4">
              <span class="font-mono text-xs font-bold tracking-widest text-blue-ink uppercase">
                ⚙️ Multi-Oracle Architecture
              </span>
              <span class="rounded bg-blue-tint px-2 py-0.5 font-mono text-[10px] font-bold text-blue-ink uppercase">
                Active Learning Loop
              </span>
            </div>

            <p class="text-xs text-ink-soft mb-3 font-sans leading-relaxed">
              Iterative query selection loop routing YouTube comments to the optimal oracle based on model prediction uncertainty (entropy):
            </p>

            <!-- Vertical Step Flow -->
            <ol class="space-y-2 font-mono text-xs text-ink flex-1 flex flex-col justify-between">
              <!-- Step 1 -->
              <li class="flex items-start gap-2.5 rounded border border-line/80 bg-paper p-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink font-bold text-paper-light text-[10px]">1</span>
                <div>
                  <p class="font-bold text-ink">Unlabeled Pool: 8,966 Comments</p>
                  <p class="text-[11px] text-ink-soft font-sans">Public YouTube comments on Indonesia's Nutritious Meal Program</p>
                </div>
              </li>

              <!-- Step 2 -->
              <li class="flex items-start gap-2.5 rounded border border-line/80 bg-paper p-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink font-bold text-paper-light text-[10px]">2</span>
                <div>
                  <p class="font-bold text-ink">IndoBERTweet Feature Extractor</p>
                  <p class="text-[11px] text-ink-soft font-sans">Embedding 768-d L2-normalized [CLS] tokens</p>
                </div>
              </li>

              <!-- Step 3: Routing -->
              <li class="flex items-start gap-2.5 rounded border border-blue-ink/40 bg-blue-tint/60 p-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-ink font-bold text-paper-light text-[10px]">3</span>
                <div class="w-full">
                  <p class="font-bold text-blue-ink">Entropy-Based Uncertainty Routing</p>
                  <div class="mt-2 space-y-1.5 text-[10.5px]">
                    <div class="flex items-center justify-between bg-paper/90 px-2 py-1 rounded border border-red-200">
                      <span>🔴 High Entropy: <strong>Oracle A (Human)</strong></span>
                      <span class="font-bold text-red-700">W: 1.0 (~8%)</span>
                    </div>
                    <div class="flex items-center justify-between bg-paper/90 px-2 py-1 rounded border border-amber-200">
                      <span>🟡 Med Entropy: <strong>Oracle C (Fine-tuned)</strong></span>
                      <span class="font-bold text-amber-700">W: 0.7 (~33%)</span>
                    </div>
                    <div class="flex items-center justify-between bg-paper/90 px-2 py-1 rounded border border-green-200">
                      <span>🟢 Low Entropy: <strong>Oracle B (Pseudo-label)</strong></span>
                      <span class="font-bold text-green-700">W: 0.3 (~59%)</span>
                    </div>
                  </div>
                </div>
              </li>

              <!-- Step 4 -->
              <li class="flex items-start gap-2.5 rounded border border-green-ink/40 bg-green-tint/60 p-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-ink font-bold text-paper-light text-[10px]">4</span>
                <div>
                  <p class="font-bold text-green-ink">Adaptive Weighted LinearSVC</p>
                  <p class="text-[11px] text-ink-soft font-sans">90.1% manual annotation cost reduction achieved</p>
                </div>
              </li>
            </ol>
          </div>

          <!-- Bottom Note with Easter Egg Badges -->
          <div class="mt-5 pt-3 border-t border-dashed border-line flex flex-wrap items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1 font-mono text-xs text-ink-soft">
              <span>🐾</span> 100% Reproducible Pipeline
            </span>
            <span class="inline-flex items-center gap-1 rounded bg-red-100 border border-red-200 px-2 py-0.5 font-mono text-[10px] font-bold text-red-800" title="Late Game Scaling: Model F1 improves while human queries shrink to 8%">
              <span>🎮</span> Late-Game Scaling
            </span>
          </div>
        </div>

        <!-- SISI KANAN (50%): Interactive Notebook Figure Viewer -->
        <div class="rounded-xl border border-line bg-paper-light p-6 shadow-paper relative flex flex-col justify-between h-full">
          <span class="tape tape-top-center" style="--tape-color: #10b981;" aria-hidden="true"></span>

          <div class="flex flex-col flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-dashed border-line pb-2.5 mb-4">
              <div class="flex items-center gap-2">
                <span class="flex h-5 w-5 items-center justify-center rounded bg-green-tint font-mono text-xs text-green-ink">📊</span>
                <p class="font-mono text-xs font-bold tracking-widest text-ink uppercase">
                  Experimental Plots
                </p>
              </div>
              <span class="rounded bg-green-tint px-2 py-0.5 font-mono text-[10px] font-bold text-green-ink uppercase">
                Raw .ipynb Runs
              </span>
            </div>

            <!-- Figure Switcher Tabs -->
            <div class="flex flex-wrap gap-1.5 mb-3" role="tablist" aria-label="Select Research Plot">
              <button type="button" class="research-fig-btn active rounded border border-green-ink bg-green-ink px-2.5 py-1 font-mono text-[11px] font-bold text-paper-light cursor-pointer transition-all" data-fig-target="fig-learning-curve">
                Figure 1: F1 Curves
              </button>
              <button type="button" class="research-fig-btn rounded border border-line bg-paper px-2.5 py-1 font-mono text-[11px] font-bold text-ink-soft hover:text-ink cursor-pointer transition-all" data-fig-target="fig-oracle-usage">
                Figure 4: Oracle Distribution
              </button>
              <button type="button" class="research-fig-btn rounded border border-line bg-paper px-2.5 py-1 font-mono text-[11px] font-bold text-ink-soft hover:text-ink cursor-pointer transition-all" data-fig-target="fig-label-efficiency">
                Figure 3: 90.1% Efficiency
              </button>
              <button type="button" class="research-fig-btn rounded border border-line bg-paper px-2.5 py-1 font-mono text-[11px] font-bold text-ink-soft hover:text-ink cursor-pointer transition-all" data-fig-target="fig-fahma">
                FAHMA: AL-HITL
              </button>
            </div>

            <!-- Display Area -->
            <div class="relative overflow-hidden rounded-lg border border-line bg-white p-3 text-center flex-1 flex flex-col justify-center min-h-[280px]">
              <!-- Figure 1 -->
              <div id="fig-learning-curve" class="research-fig-panel block w-full">
                <div class="h-44 sm:h-52 flex items-center justify-center">
                  <img src="/images/research/ieee-learning-curves.png" alt="Figure 1: Macro-F1 Learning Curves across active learning strategies" class="max-h-full max-w-full object-contain mx-auto rounded drop-shadow-xs" loading="lazy" />
                </div>
                <p class="mt-3 font-mono text-[11px] text-ink-soft leading-normal">
                  <strong class="text-ink">Figure 1 (IEEE ICERA 2026):</strong> Macro-F1 Progression across 5 active learning strategies over 1,500 queries. Multi-Oracle configuration reliably converges to top benchmark.
                </p>
              </div>

              <!-- Figure 4 -->
              <div id="fig-oracle-usage" class="research-fig-panel hidden w-full">
                <div class="h-44 sm:h-52 flex items-center justify-center">
                  <img src="/images/research/ieee-oracle-usage.png" alt="Figure 4: Oracle Usage Distribution" class="max-h-full max-w-full object-contain mx-auto rounded drop-shadow-xs" loading="lazy" />
                </div>
                <p class="mt-3 font-mono text-[11px] text-ink-soft leading-normal">
