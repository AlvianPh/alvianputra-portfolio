---
/**
 * About Section — Option A: Balanced Scrapbook Dossier (5:7 Grid)
 * - Kolom Kiri (5 col): Polaroid Alvian diperbesar (w-64 sm:w-72) + V60 Dripper + Sleeping Cat + Mini Engineer Spec Card
 * - Kolom Kanan (7 col): Kartu Memo "What's Up" dengan Visual Lead Quote, Paragraf Padat, 3 Stat Proof Chips, dan Stiker Minat
 */
import Section from '@/components/Section.astro';
import PaperCard from '@/components/ui/PaperCard.astro';
import PhotoFrame from '@/components/ui/PhotoFrame.astro';
import HandNote from '@/components/ui/HandNote.astro';
import { portfolio } from '@/data/portfolio';
import { isFilled } from '@/lib/placeholder';

const { profile } = portfolio;
---

<Section id="about" title="About Me" index="01" label="what's up" labelColor="orange" class="border-t border-line">
  <div class="grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
    
    <!-- Sisi Kiri (5 Kolom): Foto Polaroid Alvian + Mini Engineer Spec Card -->
    <div class="flex flex-col items-center justify-start gap-5 lg:col-span-5">
      
      <!-- Polaroid Photo Frame Container with Stickers -->
      <div class="relative">
        {isFilled(profile.photo) && (
          <PhotoFrame
            src={profile.photo}
            alt={profile.name}
            caption="Alvian Putra H. · Yogyakarta"
            ratio="3 / 4"
            tilt="slight-left"
            tape="top-center"
            tapeColor="blue"
            class="w-64 sm:w-72 shadow-paper-lift"
          />
        )}

        <!-- Handcrafted V60 Coffee Dripper Sticker at top-left of Polaroid -->
        <div class="absolute -top-5 -left-2 sm:-left-4 z-20 select-none group cursor-pointer" title="Aceh Gayo V60 Pour-Over Enthusiast">
          <div class="relative transform -rotate-12 group-hover:rotate-0 transition-transform duration-300">
            <!-- Tape piece holding the dripper -->
            <span class="absolute -top-2 left-2 w-7 h-2.5 bg-amber-300/80 -rotate-6 border border-amber-500/30 shadow-2xs pointer-events-none"></span>
            
            <div class="rounded-lg border border-amber-900/30 bg-[#fef3c7] p-1.5 shadow-xs">
              <svg class="h-9 w-9 text-amber-900" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Steam lines -->
                <path class="steam-line" d="M16 8 Q18 4 16 2" stroke="#b45309" stroke-width="1.2" stroke-linecap="round"/>
                <path class="steam-line" style="animation-delay: 0.6s;" d="M20 7 Q22 3 20 1" stroke="#b45309" stroke-width="1.2" stroke-linecap="round"/>
                <path class="steam-line" style="animation-delay: 1.2s;" d="M24 8 Q26 4 24 2" stroke="#b45309" stroke-width="1.2" stroke-linecap="round"/>
                <!-- V60 Cone Dripper -->
                <path d="M10 11 L30 11 L23 24 L17 24 Z" fill="#fde68a" stroke="#78350f" stroke-width="1.5" stroke-linejoin="round"/>
                <!-- Filter Paper Ribs -->
                <line x1="14" y1="12" x2="19" y2="23" stroke="#b45309" stroke-width="0.8" stroke-dasharray="1 1"/>
                <line x1="26" y1="12" x2="21" y2="23" stroke="#b45309" stroke-width="0.8" stroke-dasharray="1 1"/>
                <!-- Dripper Base Plate -->
                <ellipse cx="20" cy="24" rx="8" ry="1.5" fill="#fef3c7" stroke="#78350f" stroke-width="1.2"/>
                <!-- Coffee Server Carafe Below -->
                <path d="M15 25 L12 34 C12 36 15 37 20 37 C25 37 28 36 28 34 L25 25" fill="#fef9c3" stroke="#78350f" stroke-width="1.2" stroke-linejoin="round"/>
                <!-- Brewed Aceh Gayo Coffee Level -->
                <path d="M13 32 C14 34 17 35 20 35 C23 35 26 34 27 32 L27.5 33.5 C27 35.5 24 36.5 20 36.5 C16 36.5 13 35.5 12.5 33.5 Z" fill="#92400e"/>
                <!-- Carafe Handle -->
                <path d="M28 27 C31 27 32 32 27 33" stroke="#78350f" stroke-width="1.2" fill="none" stroke-linecap="round"/>
              </svg>
              <span class="block font-mono text-[8px] font-bold text-amber-900 text-center tracking-tighter">V60 · ACEH</span>
            </div>
          </div>
        </div>

        <!-- Cute sleeping cat sticker curled up at the corner of Polaroid -->
        <div class="cat-sleeping absolute -bottom-3 right-6 sm:right-10 z-10 select-none pointer-events-none" title="Zzz... sleeping coding buddy">
          <svg class="h-10 w-12 drop-shadow-sm" viewBox="0 0 60 50" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 35 C10 20, 25 15, 45 20 C55 24, 55 38, 48 42 C40 46, 15 46, 10 35 Z" fill="#ffffff" stroke="#231f20" stroke-width="2" stroke-linejoin="round"/>
            <path d="M12 34 C12 22, 25 17, 43 22 C52 26, 52 36, 46 40 C38 44, 16 44, 12 34 Z" fill="#FFFDF8"/>
            <polygon points="16,22 22,17 24,24" fill="#FCA5A5" stroke="#231f20" stroke-width="1.5"/>
            <polygon points="26,20 32,17 33,23" fill="#FCA5A5" stroke="#231f20" stroke-width="1.5"/>
            <path d="M19 28 Q23 31 27 28" stroke="#231f20" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            <ellipse cx="38" cy="30" rx="6" ry="4" fill="#FDBA74" opacity="0.85"/>
            <path d="M48 38 C54 36, 54 28, 48 26" stroke="#231f20" stroke-width="2" stroke-linecap="round" fill="none"/>
          </svg>
          <span class="absolute -top-2.5 right-1 font-hand text-[10px] font-bold text-ink-soft animate-pulse">Zzz...</span>
        </div>
      </div>

      <!-- Quick Engineer Profile / Workspace Snapshot Card -->
      <div class="relative w-full max-w-xs sm:max-w-sm rounded-lg border border-line bg-paper-light p-4 sm:p-5 shadow-paper rotate-[0.8deg] hover:rotate-0 transition-transform duration-200">
        <!-- Washi tape at top -->
        <span class="tape tape-top-center" style="--tape-color: #93c5fd;" aria-hidden="true"></span>

        <!-- Card Header -->
        <div class="flex items-center justify-between border-b border-dashed border-line pb-2.5 mb-3">
          <span class="font-mono text-[10px] sm:text-[11px] font-extrabold uppercase tracking-widest text-ink-soft">
            ENGINEER_SNAPSHOT // PROFILE
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 border border-green-200 px-2 py-0.5 font-mono text-[10px] font-bold text-green-ink">
            <span class="h-1.5 w-1.5 rounded-full bg-green-ink animate-pulse"></span> Available
          </span>
        </div>

        <!-- Spec Data Rows (No duplicate GPA or Campus) -->
        <dl class="space-y-2 font-mono text-xs">
          <div class="flex items-baseline justify-between gap-2">
            <dt class="text-ink-soft text-[11px]">Primary Role</dt>
            <dd class="font-bold text-ink text-right">Software Engineer</dd>
          </div>
          <div class="flex items-baseline justify-between gap-2">
            <dt class="text-ink-soft text-[11px]">Core Platforms</dt>
            <dd class="font-semibold text-blue-ink text-right">Mobile & Web</dd>
          </div>
          <div class="flex items-baseline justify-between gap-2">
            <dt class="text-ink-soft text-[11px]">Base Location</dt>
            <dd class="font-medium text-ink text-right">Yogyakarta, ID</dd>
          </div>
          <div class="flex items-baseline justify-between gap-2 border-t border-dashed border-line/70 pt-2">
            <dt class="text-ink-soft text-[11px]">Daily Fuel</dt>
            <dd class="font-bold text-amber-900 text-right">Kopi Tubruk & Lofi ☕</dd>
          </div>
          <div class="flex items-baseline justify-between gap-2">
            <dt class="text-ink-soft text-[11px]">Work Mode</dt>
            <dd class="font-bold text-cyan-900 text-right">Flow State 🎧</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Sisi Kanan (7 Kolom): Kartu Memo "What's Up" dengan Narasi & Pembagian Data Bersih -->
    <div class="space-y-6 lg:col-span-7">
      <PaperCard
        surface="lined"
        tilt="none"
        padding="none"
        interactive
        class="overflow-hidden border-line bg-paper-light p-6 sm:p-8 shadow-paper relative"
      >
        <!-- Authentic Coffee Ring Watermark on Memo Paper -->
        <div class="coffee-ring top-4 right-8 w-24 h-24 opacity-25 pointer-events-none" aria-hidden="true"></div>

        <!-- Card Tab Header (Cleaned of GPA repetition) -->
        <div class="flex items-center justify-between border-b border-line pb-3 mb-5 relative z-10">
          <div class="flex items-center gap-2">
            <span class="rounded bg-orange-tint px-2.5 py-0.5 font-mono text-xs font-bold text-orange-ink uppercase">
              what's up
            </span>
            <HandNote color="blue" size="sm" class="hidden sm:inline-flex">background & engineering mindset</HandNote>
          </div>
          <span class="font-mono text-xs text-ink-soft">Yogyakarta, Indonesia</span>
        </div>

        <!-- Visual Lead Hook / Pull Quote -->
        <div class="border-l-3 border-orange-ink pl-3.5 sm:pl-4 py-1 mb-5 relative z-10">
          <p class="font-hand text-xl sm:text-2xl font-bold text-ink leading-snug">
            "Building practical mobile and web systems, backed by applied NLP research."
          </p>
        </div>

        <!-- Structured Narrative Paragraphs (Focusing on approach & craft, not repeating stats) -->
        <div class="space-y-4 text-base sm:text-lg leading-relaxed text-ink relative z-10">
          <p>
            I build practical, production-ready software designed for longevity and real user value. My core engineering toolkit centers on <strong class="text-blue-ink">Flutter</strong> for responsive mobile applications and <strong class="text-orange-ink">Laravel</strong> for structured backend architectures, supported by offline-first SQLite persistence and clean Git workflows.
          </p>
          <p class="text-sm sm:text-base text-ink-soft leading-relaxed">
            Beyond shipping software, I conduct applied research in <strong class="text-green-ink">Natural Language Processing and active learning</strong> (IndoBERT) to optimize annotation efficiency. Teaching Coding and Artificial Intelligence to 140+ vocational students at SMK Koperasi also honed my ability to translate complex architectures into clear, actionable engineering principles.
          </p>
        </div>

        <!-- Proof Stat Chips (The SINGLE authoritative place where GPA, Publications, & Teaching numbers live) -->
        <div class="mt-6 grid grid-cols-3 gap-2 sm:gap-3 border-t border-dashed border-line pt-3 relative z-10">
          <div class="rounded border border-line bg-paper/80 p-2 sm:p-2.5 text-center shadow-2xs">
            <span class="block font-mono text-lg sm:text-xl font-extrabold text-blue-ink leading-tight">3.95</span>
            <span class="block font-mono text-[10px] text-ink-soft uppercase tracking-tight">GPA · STMIK El Rahma</span>
          </div>
          <div class="rounded border border-line bg-paper/80 p-2 sm:p-2.5 text-center shadow-2xs">
            <span class="block font-mono text-lg sm:text-xl font-extrabold text-green-ink leading-tight">2x</span>
            <span class="block font-mono text-[10px] text-ink-soft uppercase tracking-tight">Papers (IEEE & FAHMA)</span>
          </div>
          <div class="rounded border border-line bg-paper/80 p-2 sm:p-2.5 text-center shadow-2xs">
            <span class="block font-mono text-lg sm:text-xl font-extrabold text-orange-ink leading-tight">140+</span>
            <span class="block font-mono text-[10px] text-ink-soft uppercase tracking-tight">Students Mentored</span>
          </div>
        </div>
      </PaperCard>
    </div>
  </div>
</Section>
