---
/** Panah coretan tangan (dekoratif, aria-hidden). Warna ikut `currentColor`. */
interface Props {
  variant?: 'right' | 'down' | 'curve-right' | 'curve-down' | 'loop';
  size?: number;
  class?: string;
}

const { variant = 'curve-right', size = 48, class: className } = Astro.props;

const paths: Record<NonNullable<Props['variant']>, { line: string; head: string }> = {
  right: { line: 'M4 26 C 16 23, 30 27, 42 24', head: 'M35 18 L 43 24 L 35 30' },
  down: { line: 'M24 4 C 22 16, 26 28, 23 41', head: 'M17 34 L 23 42 L 29 34' },
  'curve-right': { line: 'M5 10 C 8 30, 22 38, 41 33', head: 'M33 27 L 42 33 L 34 40' },
  'curve-down': { line: 'M8 6 C 30 6, 40 18, 33 40', head: 'M26 34 L 33 41 L 39 32' },
  loop: { line: 'M4 30 C 14 30, 20 10, 12 10 C 4 10, 10 34, 42 28', head: 'M34 22 L 43 28 L 35 35' },
};

const { line, head } = paths[variant];
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['inline-block shrink-0', className]}
>
  <path d={line} />
  <path d={head} />
</svg>
