---
/**
 * Currently Exploring — dua halaman notebook terbuka, setara (tidak ada yang diutamakan).
 * Isi dari portfolio.ts → exploring.
 */
import Section from '@/components/Section.astro';
import PaperCard from '@/components/ui/PaperCard.astro';
import { portfolio } from '@/data/portfolio';

const { exploring } = portfolio;
const pageClass = ['spread-left', 'spread-right'];
---

<Section id="exploring" title="Currently Exploring" index="07" label="open pages" class="border-t border-line">
  <p class="mb-10 max-w-2xl text-lg text-ink-soft">
    I'm exploring two directions in parallel and keeping both open.
  </p>

  <ul class="grid gap-8 md:grid-cols-2 md:gap-0">
    {exploring.map((track, i) => {
      const headingId = `exploring-${i}-title`;
      const rows = [
        { label: 'Currently learning', value: track.learning },
        { label: 'Building', value: track.building },
        { label: 'Want to explore', value: track.exploring },
      ];
      return (
        <PaperCard
          as="li"
          surface="lined"
          padding="lg"
          ariaLabelledby={headingId}
          class={pageClass[i % 2]}
        >
          <p class="font-mono text-xs font-semibold tracking-widest text-ink-soft uppercase">{track.label}</p>
          <h3 id={headingId} class="mt-1">{track.title}</h3>
          <dl class="mt-6 space-y-5">
            {rows.map((row) => (
              <div>
                <dt class="font-hand text-lg leading-none text-blue-ink">{row.label}</dt>
                <dd class="mt-1 break-words">{row.value}</dd>
              </div>
            ))}
          </dl>
        </PaperCard>
      );
    })}
  </ul>
</Section>
